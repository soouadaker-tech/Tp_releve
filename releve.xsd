<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
    
    <!-- Définition de l'élément racine -->
    <xs:element name="releve">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="dateReleve" type="xs:date"/>
                <xs:element name="solde" type="xs:decimal"/>
                <xs:element name="operations" type="TypeOperations"/>
            </xs:sequence>
            <xs:attribute name="RIB" type="TypeRIB" use="required"/>
        </xs:complexType>
    </xs:element>
    
    <!-- Type complexe pour l'élément operations -->
    <xs:complexType name="TypeOperations">
        <xs:sequence>
            <xs:element name="operation" type="TypeOperation" maxOccurs="unbounded"/>
        </xs:sequence>
        <xs:attribute name="dateDebut" type="xs:date" use="required"/>
        <xs:attribute name="dateFin" type="xs:date" use="required"/>
    </xs:complexType>
    
    <!-- Type complexe pour l'élément operation -->
    <xs:complexType name="TypeOperation">
        <xs:attribute name="type" type="EnumTypeOp" use="required"/>
        <xs:attribute name="date" type="xs:date" use="required"/>
        <xs:attribute name="montant" type="xs:decimal" use="required"/>
        <xs:attribute name="description" type="xs:string" use="optional"/>
    </xs:complexType>
    
    <!-- Restrictions personnalisées -->
    <xs:simpleType name="TypeRIB">
        <xs:restriction base="xs:string">
            <xs:pattern value="[0-9]{24}"/>
        </xs:restriction>
    </xs:simpleType>
    
    <xs:simpleType name="EnumTypeOp">
        <xs:restriction base="xs:string">
            <xs:enumeration value="CREDIT"/>
            <xs:enumeration value="DEBIT"/>
        </xs:restriction>
    </xs:simpleType>
    
</xs:schema>